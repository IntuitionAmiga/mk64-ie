*.swp
.vscode/*
.idea/

# General project-specific ignores
__pycache__/
doxygen/doxygen/*
docs/html/*
xml/*
/build/*
# Decomp permuter
/nonmatchings/*
*.dump
*.mio0
# Source ROM inputs are user-supplied local files, never repository content.
*.z64
*.map
.assets-local.txt

# Torch
include/assets/*
tools/torch/*

# no context header for now, until it's greenlit for the repo
context_gen_header.h
contexts/*
tools/m2ctx.py
# regardless of the above, the context file itself shouldnt be there
ctx.c
# diff.py -o requires a copy of the build folder
expected/*

# Assets. Generally ignored, but ones with "custom" in the name are fine.
/bin/*
/modding/*
# course_textures.linkonly.* regenerate via tools/linkonly_generator.py
# (see the Makefile rule); keep ignoring them.
/courses/**/*linkonly*
/textures/**/*.png
/textures/**/*.bin
/assets/**/.export
/assets/**/*.bin
/assets/**/*.png
/assets/**/*.mio0
/assets/**/*.raw

# Neutral generated ROM asset layout (Stage 1.5 pipeline output).
# Regenerate with `make assets`; check with `make assets-verify`.
/rom_assets/
/assets/**/*.inc.c
# assets/code sources (wrapper .c AND their #included .inc.c texel
# payloads) are required build inputs with no in-tree generator
# (hand-maintained decomp artifacts); they must be tracked or a clean
# checkout cannot build the full game image. The negation re-includes
# the payloads the broad /assets/**/*.inc.c rule above would swallow.
# Only regenerable image intermediates stay ignored here.
!/assets/code/**/*.inc.c
/assets/code/**/*.png
/assets/code/**/*.bin
/music/**/*.m64
/sound/**/*.m64
/sound/**/*.aiff
!/textures/**/*custom*.png
!/textures/**/*custom*/**/*.png
!/sound/**/*custom*.m64
!/sound/**/*custom*/**/*.m64
!/sound/**/*custom*.aiff
!/sound/**/*custom*/**/*.aiff
!/assets/**/*custom*.bin
!/assets/**/*custom*/**/*.bin

# Doxygen
docs/html/*
docs/doxygen_syms.md

# windows build
mingw64/
.ash_history
!tools/ido-recomp/*/*

# models
*.blend

# torch
torch.hash.yml

tmp
._*


# runtime EEPROM save
eeprom.sav
