-- P0.3: M68K worker throughput under real bus/JIT contention.
--
-- Boots the self-contained pack, waits for the attract demo to enter the
-- race, then COSTARTs the echo service on the M68K worker and runs the
-- throughput kernel (4 KiB sweep + Voodoo enable write per iteration) while
-- the game keeps running on the main CPU. The op is SWEEP_ONLY: the game's
-- own T&L dispatch produces on IE64 ring 5, and the ring protocol is
-- single-producer, so the worker must not enqueue there concurrently. The
-- IE64-dispatch share of the kernel is characterised idle by
-- ie-m68k-echo-smoke instead.
--
-- Buffers live at 0x900000 (zero padding between the pack TOC at 0x600000
-- and the asset blobs at 0x1000000): plain guest RAM, unused at runtime,
-- read big-endian by the worker.
local C = 0x000F2340
local CMD, CPU, CMD_STATUS = C + 0x00, C + 0x04, C + 0x08
local TICKET, TICKET_STATUS = C + 0x10, C + 0x14
local OP, REQ_PTR, REQ_LEN = C + 0x18, C + 0x1C, C + 0x20
local RESP_PTR, RESP_CAP, NAME_PTR = C + 0x24, C + 0x28, C + 0x30
local CMD_START, CMD_ENQUEUE, CMD_POLL = 1, 3, 4
local CPU_M68K = 4
local S = 0x0009F000
local NAME, REQ, STATUS = 0x900000, 0x900100, 0x900200
local SOURCE, DEST = 0x901000, 0x902000
local WORDS, ITERATIONS = 1024, 500
local OP_SWEEP_ONLY = 0x53575030

local function frozen(fn)
    cpu.freeze()
    local ok, result = pcall(fn)
    cpu.resume()
    if not ok then
        sys.print("M68K WORKER LOAD FAIL: " .. tostring(result))
        sys.exit(1)
    end
    return result
end

local function read_be32(addr)
    return frozen(function()
        return mem.read8(addr) * 0x1000000 + mem.read8(addr + 1) * 0x10000
             + mem.read8(addr + 2) * 0x100 + mem.read8(addr + 3)
    end)
end

local function write_be32(addr, value)
    frozen(function()
        mem.write8(addr, math.floor(value / 0x1000000) % 0x100)
        mem.write8(addr + 1, math.floor(value / 0x10000) % 0x100)
        mem.write8(addr + 2, math.floor(value / 0x100) % 0x100)
        mem.write8(addr + 3, value % 0x100)
    end)
end

-- Wait for boot, then for the attract demo race (swap counter well past the
-- ~535-swap race entry).
local deadline = sys.time_ms() + 60000
while read_be32(S) ~= 0x4D4B3634 and sys.time_ms() < deadline do sys.wait_ms(200) end
if read_be32(S) ~= 0x4D4B3634 then
    sys.print("M68K WORKER LOAD FAIL: game did not boot")
    sys.exit(1)
end
deadline = sys.time_ms() + 120000
while read_be32(S + 16) < 700 and sys.time_ms() < deadline do sys.wait_ms(500) end
if read_be32(S + 16) < 700 then
    sys.print("M68K WORKER LOAD FAIL: attract race never started (swaps="
        .. read_be32(S + 16) .. ")")
    sys.exit(1)
end

-- The pack load clobbers the mailbox region; the game re-inits only its own
-- ring 5. Reset the M68K ring 2 header (head=0, tail=0, cap=16) BEFORE the
-- worker starts polling it.
frozen(function()
    mem.write8(0x790600, 0)
    mem.write8(0x790601, 0)
    mem.write8(0x790602, 16)
end)

-- COSTART the echo service.
frozen(function()
    local n = "build/ie/echo.ie68"
    for i = 1, #n do mem.write8(NAME + i - 1, string.byte(n, i)) end
    mem.write8(NAME + #n, 0)
end)
mem.write32(CPU, CPU_M68K)
mem.write32(NAME_PTR, NAME)
mem.write32(CMD, CMD_START)
if mem.read32(CMD_STATUS) ~= 0 then
    sys.print("M68K WORKER LOAD FAIL: COSTART err=" .. mem.read32(C + 0x0C))
    sys.exit(1)
end

-- Fill source pattern and the big-endian request block.
frozen(function()
    for i = 0, WORDS * 4 - 1 do mem.write8(SOURCE + i, (i * 7) % 256) end
end)
write_be32(REQ + 0, SOURCE)
write_be32(REQ + 4, DEST)
write_be32(REQ + 8, ITERATIONS)
write_be32(REQ + 12, WORDS)
write_be32(STATUS + 4, 0)

local swaps_before = read_be32(S + 16)
local t0 = sys.time_ms()
mem.write32(CPU, CPU_M68K)
mem.write32(OP, OP_SWEEP_ONLY)
mem.write32(REQ_PTR, REQ)
mem.write32(REQ_LEN, 16)
mem.write32(RESP_PTR, STATUS)
mem.write32(RESP_CAP, 16)
mem.write32(CMD, CMD_ENQUEUE)
local ticket = mem.read32(TICKET)
if ticket == 0 then
    sys.print("M68K WORKER LOAD FAIL: enqueue err=" .. mem.read32(C + 0x0C))
    sys.exit(1)
end
deadline = sys.time_ms() + 60000
repeat
    mem.write32(TICKET, ticket)
    mem.write32(CMD, CMD_POLL)
    if mem.read32(TICKET_STATUS) == 2 then break end
    sys.wait_ms(100)
until sys.time_ms() >= deadline
if mem.read32(TICKET_STATUS) ~= 2 then
    sys.print("M68K WORKER LOAD FAIL: throughput request timed out")
    sys.exit(1)
end
local elapsed = sys.time_ms() - t0
local swaps_after = read_be32(S + 16)
local usec = read_be32(STATUS + 4)
sys.print(string.format(
    "M68K WORKER LOAD PASS: worker=%dus/op under game load (idle baseline: ie-m68k-echo-smoke); game advanced %d swaps in %dms",
    usec, swaps_after - swaps_before, elapsed))
sys.exit(0)
