-- Stage 3 runtime-skeleton smoke: boot the hello image and verify the
-- boot status block it publishes (see ie/ie_mmio.h for the layout).
--
-- Run (from the repo root, engine checkout beside this repo):
--   ../IntuitionEngine/bin/ie_headless build/ie/hello.ie68 \
--       -script ie/smoke/hello_smoke.ies
-- Exit code 0 = pass, 1 = fail.

local STATUS_ADDR = 0x0009F000
local MAGIC = 0x4D4B3634 -- 'MK64'
local WANT_CHECKS = 0x7  -- BSS | DATA | STACK
local TIMEOUT_MS = 10000
local SAMPLE_MS = 50

-- The guest is big-endian; mem.read32 returns the bus (little-endian)
-- view, so compose 32-bit guest values from explicit byte reads.
local function read_be32(addr)
    return mem.read8(addr) * 0x1000000
        + mem.read8(addr + 1) * 0x10000
        + mem.read8(addr + 2) * 0x100
        + mem.read8(addr + 3)
end

-- dbg.freeze() halts the CPU and dbg.resume() alone does not restart
-- it; dbg.close() does. Each sample therefore opens and closes the
-- debugger around the frozen reads.
local function read_status()
    dbg.open()
    dbg.freeze()
    local magic = read_be32(STATUS_ADDR)
    local checks = read_be32(STATUS_ADDR + 4)
    local beat = read_be32(STATUS_ADDR + 8)
    dbg.resume()
    dbg.close()
    return magic, checks, beat
end

local deadline = sys.time_ms() + TIMEOUT_MS
local magic, checks, beat = 0, 0, 0

while sys.time_ms() < deadline do
    magic, checks, beat = read_status()
    if magic == MAGIC then
        break
    end
    sys.wait_ms(SAMPLE_MS)
end

if magic ~= MAGIC then
    sys.print(string.format("SMOKE FAIL: no boot magic (read 0x%08X)", magic))
    sys.exit(1)
end

if checks ~= WANT_CHECKS then
    sys.print(string.format("SMOKE FAIL: checks 0x%X, want 0x%X", checks, WANT_CHECKS))
    sys.exit(1)
end

-- The heartbeat must advance: proves the program is still executing.
sys.wait_ms(200)
local _, _, beat2 = read_status()
if beat2 == beat then
    sys.print(string.format("SMOKE FAIL: heartbeat stuck at %d", beat))
    sys.exit(1)
end

sys.print("SMOKE PASS: runtime skeleton boots, checks 0x7, heartbeat advancing")
sys.exit(0)
