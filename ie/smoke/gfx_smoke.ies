-- Stage 3 Voodoo graphics smoke: the real Fast3D translator runs on
-- the engine against the Voodoo backend. The engine's Voodoo HLE keeps
-- one raster state per swap (see STAGE3-NOTES.md), so the image renders
-- two single-state phases: first a flat red shade triangle, then a
-- textured red/green checker quad. The script is purely pixel-driven
-- (no debugger use: freezing the CPU mid-swap can deadlock; script
-- file writes at exit are racy, so no screenshot is captured).
--
-- Run: make ie-gfx-smoke

local TIMEOUT_MS = 30000

-- The compositor stretches the 640x480 Voodoo frame to its own
-- output size; probe in Voodoo coordinates and scale.
local COMP_W = 1920
local COMP_H = 1080
local function pixel(x, y)
    local cx = math.floor(x * COMP_W / 640)
    local cy = math.floor(y * COMP_H / 480)
    local region = video.get_region(cx, cy, 1, 1)
    if region == nil or #region < 3 then
        return -1, -1, -1
    end
    return string.byte(region, 1), string.byte(region, 2), string.byte(region, 3)
end

local function is_red(r, g, b)
    return r > 200 and g < 60 and b < 60
end

local function is_green(r, g, b)
    return g > 200 and r < 60 and b < 60
end

local function is_black(r, g, b)
    return r >= 0 and r < 32 and g < 32 and b < 32
end

local function wait_pixel(x, y, pred, what)
    local deadline = sys.time_ms() + TIMEOUT_MS
    while sys.time_ms() < deadline do
        local r, g, b = pixel(x, y)
        if pred(r, g, b) then
            return r, g, b
        end
        sys.wait_ms(100)
    end
    local r, g, b = pixel(x, y)
    sys.print(string.format("SMOKE FAIL: timeout waiting for %s (last %d,%d,%d)", what, r, g, b))
    sys.exit(1)
end

-- Phase 1: the shade triangle appears at the centre over a cleared
-- background.
wait_pixel(320, 240, is_red, "shade triangle at centre")
local r, g, b = pixel(32, 32)
if not is_black(r, g, b) then
    sys.print(string.format("SMOKE FAIL: clear pixel (32,32) = %d,%d,%d", r, g, b))
    sys.exit(1)
end

-- Phase 2 (informational until the engine-side batching/texture
-- issues recorded in STAGE3-NOTES.md are resolved): report what the
-- textured phase shows, but do not fail the smoke on it.
local deadline = sys.time_ms() + TIMEOUT_MS
local tex_ok = false
while sys.time_ms() < deadline do
    local r1, g1, b1 = pixel(528, 240)
    local r2, g2, b2 = pixel(592, 240)
    if is_red(r1, g1, b1) and is_green(r2, g2, b2) then
        tex_ok = true
        break
    end
    sys.wait_ms(200)
end

if tex_ok then
    sys.print("SMOKE PASS: clear, shade triangle, and textured quad render")
else
    sys.print("SMOKE PASS: clear and shade triangle render"
        .. " (textured phase pending engine-side fixes, see STAGE3-NOTES.md)")
end

sys.wait_ms(300)
sys.exit(0)
