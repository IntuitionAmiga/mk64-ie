-- Worker self-timed measurements over the attract race steady state.
--
-- A debugger freeze costs ~0.7 s of guest progress (measured), so this
-- probe brackets one untouched span with exactly two reads and uses
-- the workers' cumulative counters:
--   gfx service trace block 0x9EF80: slot 4 frames, slot 6 cumulative
--   translation+submit usec (pre swap wait), slot 7 cumulative frame
--   usec (incl swap wait), slot 8 max translation usec.
--   audio service feedback 0x9EFC0: +0x10 pumps, +0x1C cumulative
--   pump usec.
--
-- Run: make ie-svc-timing-probe IE_GFX_SVC=1 IE_AUDIO_SVC=1

local STATUS_ADDR = 0x0009F000
local STATUS_MAGIC = 0x4D4B3634 -- 'MK64'
local GAMESTATE_ADDR = @GAMESTATE_ADDR@ -- s32 gGamestate; RACING == 4
local GFX_TRACE = 0x0009EF80
local AUDIO_FB = 0x0009EFC0

local RACE_WAIT_TIMEOUT_MS = 480000
local WARMUP_MIN_SWAPS = 560
local RACE_LAST_SWAP = 3000
local SPAN_MS = 8000
local WARMUP_POLL_MS = 1000

local function read_be32(addr)
    return mem.read8(addr) * 0x1000000 + mem.read8(addr + 1) * 0x10000
         + mem.read8(addr + 2) * 0x100 + mem.read8(addr + 3)
end

local function probe()
    local out = {}
    dbg.open()
    dbg.freeze()
    out.magic = read_be32(STATUS_ADDR)
    out.swaps = read_be32(STATUS_ADDR + 16)
    out.state = read_be32(GAMESTATE_ADDR)
    out.gfx_frames = read_be32(GFX_TRACE + 16)
    out.gfx_cum_xlat = read_be32(GFX_TRACE + 24)
    out.gfx_cum_frame = read_be32(GFX_TRACE + 28)
    out.gfx_max_xlat = read_be32(GFX_TRACE + 32)
    out.aud_pumps = read_be32(AUDIO_FB + 0x10)
    out.aud_cum = read_be32(AUDIO_FB + 0x1C)
    dbg.resume()
    dbg.close()
    return out
end

sys.print("SVC TIMING: waiting for the demo race steady state")
local deadline = sys.time_ms() + RACE_WAIT_TIMEOUT_MS
local a = nil
while sys.time_ms() < deadline do
    a = probe()
    if a.magic == STATUS_MAGIC and a.state == 4
        and a.swaps >= WARMUP_MIN_SWAPS then
        break
    end
    sys.wait_ms(WARMUP_POLL_MS)
end
if a == nil or a.magic ~= STATUS_MAGIC or a.state ~= 4
    or a.swaps < WARMUP_MIN_SWAPS then
    sys.print("SVC TIMING FAIL: race steady state never reached")
    sys.exit(1)
end

local t0 = sys.time_ms()
sys.wait_ms(SPAN_MS)
local b = probe()
local elapsed_s = (sys.time_ms() - t0) / 1000.0

if b.state ~= 4 or b.swaps > RACE_LAST_SWAP then
    sys.print(string.format(
        "SVC TIMING FAIL: span left the race (state=%d swaps=%d)",
        b.state, b.swaps))
    sys.exit(1)
end

local frames = b.gfx_frames - a.gfx_frames
local pumps = b.aud_pumps - a.aud_pumps
sys.print(string.format(
    "SVC TIMING PASS: %.1f s untouched span, swaps %d -> %d (%.2f fps), gfx frames %d, audio pumps %d",
    elapsed_s, a.swaps, b.swaps, (b.swaps - a.swaps) / elapsed_s, frames, pumps))
if frames > 0 then
    sys.print(string.format(
        "gfx worker: avg translation+submit %.0f us, avg frame incl swap wait %.0f us, max translation (since boot) %d us",
        (b.gfx_cum_xlat - a.gfx_cum_xlat) / frames,
        (b.gfx_cum_frame - a.gfx_cum_frame) / frames,
        b.gfx_max_xlat))
end
if pumps > 0 then
    sys.print(string.format("audio worker: avg pump %.0f us",
        (b.aud_cum - a.aud_cum) / pumps))
end
sys.exit(0)
